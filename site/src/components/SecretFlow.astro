---
/**
 * Three stages of one `exec` call. The key name is public, the value moves
 * through memory, and the child reads an environment variable.
 *
 * Styled with Tailwind utilities. `not-content` keeps Starlight's markdown list
 * spacing from fighting the grid.
 */
const stages = [
	{
		emoji: '📛',
		label: 'Name',
		code: 'nvault exec -- npm test',
		detail: 'The key name is in argv. The process table can see it, and that is fine.',
	},
	{
		emoji: '🔐',
		label: 'Resolve',
		code: 'apps/prod/db#password',
		detail: 'nvault reads the value from the provider. The value stays out of argv.',
	},
	{
		emoji: '🧪',
		label: 'Use',
		code: 'process.env.DB_PASSWORD',
		detail: 'The child reads an environment variable. Nothing prints the value.',
	},
];
---

<ol
	class="not-content my-8 grid list-none gap-4 p-0 sm:grid-cols-3"
	aria-label="What exec puts in argv, what it resolves, and what the child reads"
>
	{
		stages.map((stage, index) => (
			<li class="flex flex-col gap-2 rounded-2xl border border-border bg-bg-nav p-5">
				<div class="flex items-center gap-2">
					<span class="text-xl" aria-hidden="true">
						{stage.emoji}
					</span>
					<span class="text-xs font-semibold tracking-wider text-text-muted uppercase">
						{index + 1}. {stage.label}
					</span>
				</div>
				<code class="font-mono text-sm break-words text-accent-high">{stage.code}</code>
				<p class="m-0 text-sm text-text">{stage.detail}</p>
			</li>
		))
	}
</ol>
